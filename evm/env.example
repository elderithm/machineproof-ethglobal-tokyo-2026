# Copy to evm/.env (gitignored). Needed only to DEPLOY to Sepolia — local
# compile/test need nothing here.

# A Sepolia JSON-RPC endpoint. A free public one works:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key (0x...) of a throwaway deployer wallet holding a little Sepolia ETH
# (get some from a Sepolia faucet). SERVER-ONLY, never commit.
EVM_DEPLOYER_PRIVATE_KEY=
