# ---------------------------------------------------------------------------
# MachineProof — ETHGlobal Tokyo 2026
# Copy to `.env.local` and fill in after deploying. NEVER commit real secrets.
# (Named env.example — .env* is gitignored so it can never be committed.)
# ---------------------------------------------------------------------------

# --- Sui ---
NEXT_PUBLIC_SUI_NETWORK=testnet
# RPC endpoint. Mysten's public fullnodes have DROPPED JSON-RPC, so this app
# defaults to a JSON-RPC-compatible endpoint (https://sui-testnet-rpc.publicnode.com).
# Override here if you have your own JSON-RPC endpoint.
NEXT_PUBLIC_SUI_RPC_URL=
# Populated by `npm run sui:deploy` and `npm run sui:seed`:
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_MACHINE_ASSET_ID=
NEXT_PUBLIC_AUCTION_ID=
# Public object id of the AdminCap (used only to build the register tx; not a secret).
NEXT_PUBLIC_ADMIN_CAP_ID=

# --- World ID 4.0 (relying-party model) ---
# From https://developer.world.org: App id (staging is fine for the demo).
NEXT_PUBLIC_WORLD_APP_ID=app_0000000000000000000000000000
# Action identifier you create for the app (after registering the relying party).
NEXT_PUBLIC_WORLD_ACTION=machineproof-auction-entry
# Relying-party id from "Register relying party" (e.g. rp_...). Public.
NEXT_PUBLIC_WORLD_RP_ID=
# "staging" for a Staging app + World ID Simulator; "production" for a live Orb app.
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
# SERVER-ONLY: the relying party's ECDSA signing key (hex) from RP registration.
# Used to sign proof requests (rp_context). Never expose to the browser or commit.
WORLD_RP_SIGNING_KEY=

# --- Server-only admin signer ---
# The backend holds the AdminCap and, after verifying a World proof bound to
# (auctionId, wallet), submits register_verified_bidder on-chain. It also
# advances settlement milestones.
# Export with: sui keytool export --key-identity <alias>  (bech32 suiprivkey1...),
# or let `npm run sui:deploy` generate one and print it.
# SERVER-ONLY. Never expose to the browser, never commit.
SUI_ADMIN_SECRET_KEY=

# --- Optional auction seed knobs (used by npm run sui:seed) ---
RESERVE_SUI=1
MIN_INCREMENT_SUI=0.1
AUCTION_DURATION_MINUTES=30
# Set to an existing MachineAsset id to mint a fresh auction for the SAME machine
# (instead of registering a new one) — handy after a previous auction ended.
REUSE_MACHINE_ID=
